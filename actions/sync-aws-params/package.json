{
  "name": "sync-aws-params",
  "version": "1.0.0",
  "description": "GitHub Action to sync SSM parameters and Secrets Manager entries before deployment",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "ncc build src/index.ts -o dist --source-map --minify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@aws-sdk/client-secrets-manager": "^3.624.0",
    "@aws-sdk/client-ssm": "^3.624.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.4",
    "aws-sdk-client-mock": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
